# Public URL. Use http://localhost:3000 locally and the HTTPS subdomain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Long random secret. Generate separately for production; never commit it.
PAYLOAD_SECRET=replace-with-a-long-random-secret

# Vercel / Neon Postgres connection string.
POSTGRES_URL=postgresql://user:password@host/database?sslmode=require

# Added automatically when Vercel Blob is connected. Optional for initial local development.
BLOB_READ_WRITE_TOKEN=

# Separate random salt used only to pseudonymize IPs in the in-process burst limiter.
# No raw IP address is stored in Payload or application logs by our code.
RATE_LIMIT_SALT=replace-with-another-long-random-secret

# Optional comma-separated additional origins for preview/custom domains.
ALLOWED_ORIGINS=http://localhost:3000
